<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.*?>

<AnchorPane fx:id="pane_background" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.slyblasco.frontend.NaviWaveController">
    <children>
        <TabPane tabClosingPolicy="UNAVAILABLE" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <tabs>
                <Tab fx:id="tab_barcos" text="Barcos (AIS)">
                    <content>
                        <HBox>
                            <children>
                                <AnchorPane fx:id="pane_lista_barco" minWidth="260.0" prefWidth="280.0" style="-fx-background-color: lightgray;">
                                    <HBox.margin>
                                        <Insets right="10.0" />
                                    </HBox.margin>
                           <children>
                              <ScrollPane fx:id="scrollLista" fitToWidth="true" hbarPolicy="NEVER" AnchorPane.bottomAnchor="21.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="21.0">
                                       <content>
                                          <VBox fx:id="listaBarcos" spacing="8.0">
                                             <padding>
                                                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                                             </padding>
                                          </VBox>
                                       </content>
                              </ScrollPane>
                           </children>
                                </AnchorPane>

                                <AnchorPane fx:id="pane_map" style="-fx-background-color: blue;" HBox.hgrow="ALWAYS">
                           <children>
                              <WebView fx:id="webMapa" prefHeight="598.0" prefWidth="897.0" AnchorPane.bottomAnchor="21.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="21.0" />
                           </children></AnchorPane>
                            </children>
                        </HBox>
                    </content>
                </Tab>
                <Tab fx:id="tab_grabaciones" text="Grabaciones Comunicaciones">
                    <content>
                        <SplitPane dividerPositions="0.3" orientation="VERTICAL">
                            <items>
                                <VBox minHeight="120.0" spacing="10.0">
                                    <padding>
                                        <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
                                    </padding>
                                    <children>
                                        <Label style="-fx-font-weight: bold;" text="Escucha en vivo" />
                                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                                            <children>
                                                <Button fx:id="btnEscuchar" minWidth="150.0" onAction="#alternarEscuchaEnVivo" text="Escuchar en vivo" />
                                                <Label fx:id="lblEstadoVivo" text="Desconectado" />
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label text="Nivel" />
                                                <ProgressBar fx:id="barraNivel" prefWidth="260.0" progress="0.0" />
                                                <Label text="Volumen" />
                                                <Slider fx:id="sliderVolumen" max="1.0" min="0.0" prefWidth="160.0" value="0.8" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                                <BorderPane>
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <top>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <padding>
                                        <Insets bottom="10.0" />
                                    </padding>
                                    <children>
                                        <Label style="-fx-font-weight: bold;" text="Grabaciones de comunicaciones de voz (doble click para reproducir)" />
                                        <Button onAction="#actualizarAudios" text="Actualizar" />
                                    </children>
                                </HBox>
                            </top>
                            <center>
                                <TableView fx:id="tablaAudios">
                                    <columns>
                                        <TableColumn fx:id="colFecha" prefWidth="170.0" text="Fecha" />
                                        <TableColumn fx:id="colNombre" prefWidth="500.0" text="Archivo" />
                                    </columns>
                                </TableView>
                            </center>
                            <bottom>
                                <VBox spacing="8.0">
                                    <padding>
                                        <Insets top="12.0" />
                                    </padding>
                                    <children>
                                        <Label fx:id="lblAudioActual" text="Selecciona una grabacion" />
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Button fx:id="btnPlayPausa" minWidth="90.0" onAction="#alternarReproduccion" text="Reproducir" />
                                                <Button onAction="#detenerReproduccion" text="Detener" />
                                                <Slider fx:id="sliderProgreso" disable="true" HBox.hgrow="ALWAYS" />
                                                <Label fx:id="lblTiempo" text="--:-- / --:--" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </bottom>
                        </BorderPane>
                            </items>
                        </SplitPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</AnchorPane>
